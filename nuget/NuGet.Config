<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageRestore>
    <add key="enabled" value="True" />
    <add key="automatic" value="True" />
  </packageRestore>
  <packageSources>
	<add key="nuget.nexdev.net" value="http://nuget.nexdev.net/api/v2/" />
    <add key="nuget.org" value="https://www.nuget.org/api/v2/" />
    <add key="nuget.owdev.net" value="http://nuget.owdev.net/api/v2/" />    
  </packageSources>  
  <activePackageSource>
    <add key="nuget.org" value="https://www.nuget.org/api/v2/" />
  </activePackageSource>
  <bindingRedirects>
    <add key="skip" value="False" />
  </bindingRedirects>
</configuration>