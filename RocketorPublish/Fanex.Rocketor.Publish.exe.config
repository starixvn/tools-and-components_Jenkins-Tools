<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <appSettings>
        <add key="RocketorAPI" value="http://ha.nexdev.net:7801" />
        <add key="RocketorAPITimeout" value="600000" />
        <add key="RocketorUserId" value="56" />
        <add key="RocketorUserName" value="SPVN\jenkins.ci" />
		<add key="PublishTimeout" value="3600000" />
		<add key="TestUrlFile" value="TestUrl.txt" />

        <add key="RabbitMQ-Host" value="10.18.200.122,10.18.200.123" />
        <add key="RabbitMQ-Port" value="5672" />
        <add key="RabbitMQ-UserName" value="admin" />
        <add key="RabbitMQ-Password" value="rabbitadmin!@#" />
        <add key="RabbitMQ-BuildExchangeName" value="Rocketor-BuildExchange" />
        <add key="RabbitMQ-BuildQueueName" value="Rocketor-BuildQueue" />
        <add key="RabbitMQ-BuildQueueRoutingKey" value="build-package" />
        <add key="RabbitMQ-PackageStatusQueueName" value="Rocketor-PackageStatusQueue" />
        <add key="RabbitMQ-PackageStatusExchangeName" value="Rocketor-PackageStatusExchange" />
        <add key="RabbitMQ-QuickReleaseQueueName" value="Rocketor-QuickReleaseQueue" />
        <add key="RabbitMQ-QuickReleaseExchangeName" value="Rocketor-QuickReleaseExchange" />
        <add key="RabbitMQ-AutoReleaseExchangeName" value="Rocketor-AutoReleaseExchange" />        
        <add key="RabbitMQ-MaxRetryConnection" value="3" />
    </appSettings>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.2" />
    </startup>    
</configuration>